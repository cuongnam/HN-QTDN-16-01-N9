<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_taskss_tree" model="ir.ui.view">
        <field name="name">taskss.tree</field>
        <field name="model">taskss</field>
        <field name="arch" type="xml">

            <tree string="Danh sách Công việc">

                <field name="taskss_id"/>
                <field name="taskss_name"/>
                <field name="projects_id"/>
                <field name="cong_viec_id"/>
                <field name="deadline"/>
                <field name="priority"/>
                <field name="status"/>

            </tree>

        </field>
    </record>

    <record id="view_taskss_form" model="ir.ui.view">
        <field name="name">taskss.form</field>
        <field name="model">taskss</field>
        <field name="arch" type="xml">

            <form string="Công việc">

                <sheet>

                    <group>

                        <group>

                            <field name="taskss_id"/>
                            <field name="taskss_name"/>
                            <field name="projects_id"/>
                            <field name="cong_viec_id"/>

                        </group>

                        <group>

                            <field name="start_date"/>
                            <field name="deadline"/>
                            <field name="priority"/>
                            <field name="status"/>
                            <field name="progress"/>

                        </group>

                    </group>

                    <group>

                        <field name="ly_do"/>

                    </group>

                    <notebook>

                        <page string="Chi phí">

                            <field name="expense_ids">

                                <tree editable="bottom">

                                    <field name="expenses_name"/>
                                    <field name="amount"/>
                                    <field name="date"/>
                                    <field name="budgets_id"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <record id="action_taskss" model="ir.actions.act_window">
        <field name="name">Công việc</field>
        <field name="res_model">taskss</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>