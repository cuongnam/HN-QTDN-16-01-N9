<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_taskss_tree" model="ir.ui.view">
        <field name="name">taskss.tree</field>
        <field name="model">taskss</field>
        <field name="arch" type="xml">

            <tree string="Danh sách Công việc" create="0" edit="0" delete="0">

                <field name="taskss_id" readonly="1"/>
                <field name="taskss_name" readonly="1"/>
                <field name="projects_id" readonly="1"/>
                <field name="cong_viec_id" readonly="1"/>
                <field name="deadline" readonly="1"/>
                <field name="priority" readonly="1"/>
                <field name="status" readonly="1"/>

            </tree>

        </field>
    </record>

    <record id="view_taskss_form" model="ir.ui.view">
        <field name="name">taskss.form</field>
        <field name="model">taskss</field>
        <field name="arch" type="xml">

            <form string="Công việc" create='0' edit="0" delete="0">

                <sheet>

                    <group>

                        <group>

                            <field name="taskss_id" readonly="1"/>
                            <field name="taskss_name" readonly="1"/>
                            <field name="projects_id" readonly="1"/>
                            <field name="cong_viec_id" readonly="1"/>

                        </group>

                        <group>

                            <field name="start_date" readonly="1"/>
                            <field name="deadline" readonly="1"/>
                            <field name="priority" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="progress" readonly="1"/>

                        </group>

                    </group>

                    <group>

                        <field name="ly_do" readonly="1"/>

                    </group>

                    <notebook>

                        <page string="Chi phí">

                            <field name="expense_ids">

                                <tree editable="bottom">

                                    <field name="expenses_name"/>
                                    <field name="amount"/>
                                    <field name="date"/>
                                    <field name="budgets_id"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <record id="action_taskss" model="ir.actions.act_window">
        <field name="name">Công việc</field>
        <field name="res_model">taskss</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>