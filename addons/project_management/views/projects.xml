<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_projects_tree" model="ir.ui.view">
        <field name="name">projects.tree</field>
        <field name="model">projects</field>
        <field name="arch" type="xml">
            <tree string="Danh sách Dự án">
                <field name="projects_id"/>
                <field name="projects_name"/>
                <field name="manager_name"/>
                <field name="du_an_id"/>
                <field name="start_date"/>
                <field name="actual_end_date"/>
                <field name="progress" widget="progressbar"/>
                <field name="status" widget="badge" decoration-info="status == 'draft'" decoration-success="status == 'open'" decoration-muted="status == 'close'" decoration-danger="status == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_projects_form" model="ir.ui.view">
        <field name="name">projects.form</field>
        <field name="model">projects</field>
        <field name="arch" type="xml">
            <form string="Thông tin Dự án">

                <header>
                    <button name="action_open" string="Bắt đầu Dự án" type="object" class="oe_highlight" 
                            attrs="{'invisible': [('status', '!=', 'draft')]}"/>
                    
                    <button name="action_close" string="Hoàn thành &amp; Đóng" type="object" class="oe_highlight" 
                            attrs="{'invisible': [('status', '!=', 'open')]}"/>
                    
                    <button name="action_cancel" string="Hủy bỏ Dự án" type="object" 
                            attrs="{'invisible': [('status', 'in', ['close', 'cancelled'])]}"/>
                    
                    <field name="status" widget="statusbar" statusbar_visible="draft,open,close,cancelled"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="projects_id"/>
                            <field name="projects_name"/>
                            <field name="manager_name"/>
                            <field name="nhom_ids" widget="many2many_tags"/>
                            <field name="du_an_id" readonly="1"/> </group>
                        <group>
                            <field name="start_date"/>
                            <field name="actual_end_date"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Danh sách công việc">
                            <field name="task_ids">
                                <tree>
                                    <field name="taskss_id" readonly="1"/>
                                    <field name="taskss_name"/>
                                    <field name="cong_viec_id"/>
                                    <field name="deadline"/>
                                    <field name="priority"/>
                                    <field name="progress"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Ngân sách">
                            <field name="budget_ids"/>
                        </page>

                        <page string="Ghi chú">
                            <field name="ly_do_1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_projects" model="ir.actions.act_window">
        <field name="name">Dự án</field>
        <field name="res_model">projects</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>